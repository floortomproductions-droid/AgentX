{
 "openapi": "3.1.0",
 "info": {
  "title": "NEMO x402 Agent Micro-Services",
  "version": "0.7.14",
  "description": "Pay-per-call agent services via x402 (USDC on Base + Solana), also accepting the IETF Machine Payments Protocol (MPP) and Stripe cards on $1+ routes. Unauthenticated calls return HTTP 402 carrying PAYMENT-REQUIRED (x402) and a WWW-Authenticate: Payment MPP challenge; settled calls return a Payment-Receipt. Free endpoints: /x402/catalogue, /x402/health. MCP streamable-HTTP endpoint: /x402/mcp.",
  "contact": {
   "email": "steve@nemoai.uk",
   "name": "NEMO AI Solutions",
   "url": "https://nemoai.uk"
  },
  "x-guidance": "Call GET /x402/catalogue first (free) for routes and prices. Paid routes return HTTP 402 with a PAYMENT-REQUIRED header; settle USDC on Base (first) or Solana, or pay with MPP (Authorization: ***) or Stripe cards on $1+ routes, then retry the same request. Slow jobs (roast, upgrade, classify, keywords) may answer 202 with a free /x402/jobs/:id poller. MCP streamable-HTTP at /x402/mcp exposes the catalogue and a free x402 Doctor (also reachable at /connect/mcp)."
 },
 "servers": [
  {
   "url": "https://agentx.sale"
  }
 ],
 "x-discovery": {
  "ownershipProofs": [
   "0x9702dDF83ECB770f87FF6AF04156Be7241a3fe83"
  ]
 },
