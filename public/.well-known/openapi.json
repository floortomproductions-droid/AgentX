     "protocols": [
      {
       "x402": {}
      },
      {
       "mpp": {
        "method": "evm",
        "intent": "charge",
        "currency": "USDC"
       }
      }
     ],
     "price": {
      "mode": "fixed",
      "currency": "USD",
      "amount": "0.01"
