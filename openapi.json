            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "City name (Open-Meteo geocoding)"
          }
        ],
        "x-payment-info": {
          "protocols": [
            {
              "x402": {}
            }
          ],
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          }
        },
        "responses": {
          "200": {
            "description": "Current weather JSON"
          },
          "402": {
            "description": "Payment Required"
          }
        }
